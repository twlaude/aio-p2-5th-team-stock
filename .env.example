# 이 파일을 .env로 복사한 뒤 값을 채운다. compose.release.yml의 ${VAR} 치환에 쓰인다.
# 실제 .env는 git에 커밋하지 않는다(.gitignore 처리됨).
#
# "직접 발급" 표시가 있는 값은 이 저장소에 들어 있지 않다. 실행하는 사람이 각 사이트에서
# 발급받아 채워야 하며, 비워 두면 해당 서비스의 데이터가 빠지거나 분석이 실패한다.
# 나머지 값은 기본값 그대로 두어도 로컬 실행에 문제가 없다.

# --- Postgres ---
POSTGRES_DB=stock_insight
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# disclosure_mcp 전용 두 번째 데이터베이스 이름
DISCLOSURE_POSTGRES_DB=stock_disclosure

# --- Frontend 빌드 인자 (로컬에서 이미지 직접 빌드할 때만 쓰임. Hub 이미지를
# 그대로 받아 쓰면 이미 이 값으로 구워져 있어 여기 값은 무시된다) ---
VITE_API_MODE=live

# --- Price MCP (한국투자증권) --- 직접 발급: https://apiportal.koreainvestment.com (KIS Developers 앱 등록)
# 현재가는 분석의 필수 값이라 비우면 모든 분석이 실패한다.
KIS_APP_KEY=
KIS_APP_SECRET=

# --- News MCP (NAVER API HUB) --- 직접 발급: https://console.ncloud.com 의 NAVER API HUB에서 검색(뉴스) API 앱 등록 (developers.naver.com 키가 아님)
NAVER_NEWS_CLIENT_ID=
NAVER_NEWS_CLIENT_SECRET=
# 자격증명 없이 임시로 띄워보려면 true로. 운영에서는 false.
NEWS_MOCK=false

# --- Disclosure MCP (OpenDART + 임베딩) --- 직접 발급: https://opendart.fss.or.kr (인증키 신청, 40자)
DART_API_KEY=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# --- Community MCP --- 토큰은 팀 커뮤니티 API 운영자에게 받는다(공개 발급 없음). 없으면 COMMUNITY_MOCK=auto 로 두면 예시 반응으로 대체된다.
COMMUNITY_API_URL=http://159.223.75.71:8877
COMMUNITY_API_TOKEN=
COMMUNITY_MOCK=false

# --- OpenAI (mcp_client의 Agent 서사 생성 + disclosure_mcp의 임베딩 + backend 공용) --- 직접 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
MAX_AGENT_STEPS=3

# --- Backend 인증·보안 ---
# 32바이트 이상의 무작위 문자열로 채운다. 비우면 개발용 기본값이 쓰이므로 외부에 공개할 때는 반드시 채운다.
JWT_SECRET_KEY=
JWT_EXPIRES_MINUTES=1440
# 콤마로 여러 개 허용 가능 (예: http://localhost:5173,http://localhost:8501)
CORS_ALLOWED_ORIGINS=http://localhost:8501
# /api/v1/admin/live-status Basic Auth. 기본값 그대로 두지 않는다.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# 관리자 실황 페이지의 MCP Inspector 바로가기 링크용. 이 compose를 실행하는
# 컴퓨터의 브라우저에서 접속 가능한 주소(로컬이면 localhost, 서버 배포면
# 그 서버의 공인 IP/도메인)를 넣는다.
MCP_PUBLIC_HOST=localhost
# agent_first: MCP Client Agent 결과 우선, 실패 시 Backend가 규칙 기반으로 조립 / backend: 항상 규칙 기반
NARRATIVE_SOURCE=agent_first

# --- 포트 (선택) ---
# macOS는 8021을 시스템 서비스(ftp-proxy)가 쓰고 있어 뉴스 MCP가 뜨지 않는다. 그 경우 18021 등으로 바꾼다.
# NEWS_MCP_PORT=8021

# --- 이미지 태그 (선택) ---
# TAG=latest
