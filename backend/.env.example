# backend 전용 환경변수 (실제 값은 .env — git 커밋 금지)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stock_insight
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=1800

MCP_CLIENT_URL=http://localhost:8010
MCP_CLIENT_TIMEOUT_SECONDS=75
MCP_CLIENT_MODE=mock
# agent_first: MCP Client Agent가 만든 한줄결론·개인화 우선, 실패 시 Backend가 프론트 규칙으로 조립 / backend: 항상 Backend 조립
NARRATIVE_SOURCE=agent_first

LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low

AUTH_MODE=demo
DEMO_USER_ID=demo-user-a
# 비우면 로그인이 실패한다. 로컬 개발은 아래 값 그대로, 실배포는 긴 무작위 문자열로 교체
JWT_SECRET_KEY=dev-secret-change-me-please-32-bytes-min
JWT_EXPIRES_MINUTES=1440

# 콤마로 여러 개 허용 가능 (예: http://localhost:5173,http://localhost:3000)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# /api/v1/admin/live-status 실황 페이지 Basic Auth. 배포 환경에서는 반드시 바꾼다.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
