# backend 전용 환경변수 (실제 값은 .env — git 커밋 금지)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stock_insight
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=1800

MCP_CLIENT_URL=http://localhost:8010
MCP_CLIENT_TIMEOUT_SECONDS=75
MCP_CLIENT_MODE=mock

LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low

AUTH_MODE=demo
DEMO_USER_ID=demo-user-a
JWT_SECRET_KEY=

# 콤마로 여러 개 허용 가능 (예: http://localhost:5173,http://localhost:3000)
CORS_ALLOWED_ORIGINS=http://localhost:5173
